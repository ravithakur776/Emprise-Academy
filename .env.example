# ==========================================================
# EMPRISE ACADEMY DIGITAL PLATFORM
# Environment Variables Specification
# ==========================================================

# 1. Application URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 2. Supabase Configuration (PostgreSQL + Auth + Storage)
# Obtain these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# 3. Privileged Admin Service Role Key (SERVER ONLY - NEVER EXPOSE TO BROWSER)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# 4. Optional Integrations (Free-First Architecture: optional / deferred)
# WHATSAPP_API_KEY=
# SMS_GATEWAY_API_KEY=
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
